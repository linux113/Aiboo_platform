# Server
PORT=4000

# MongoDB
MONGO_URI=mongodb://localhost:27017/aiboo

# JWT
JWT_SECRET=ab7f3e91c8d24b5a6f0e927c1d3a8b4e5f6c7d8e9f0a1b2c3d4e5f6a7b8c9d0e

# OpenAI / Groq
OPENAI_KEY=sk-placeholder-replace-with-real-key

# Backend URL
NODE_BACKEND=http://localhost:4000

# Service URLs
AGENT_SERVICE_URL=http://localhost:8001
CV_SERVICE_URL=http://localhost:5050

# Environment
NODE_ENV=development

# Load sample findings / locks / actions (all marked [DEMO]) at startup.
# Leave false to see only what your real agents report.
SEED_DEMO_DATA=false

# Logging
LOG_LEVEL=info

# API keys for service-to-service auth (comma-separated)
API_KEYS=sk-service-key-1,sk-service-key-2

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# Trust proxy count (set to number of reverse proxies)
TRUST_PROXY=1

# Optional camera (CV) service - used only for the "CV" badge health check.
# Leave as is if you don't run cv-service (badge will just show "CV off").
CV_SERVICE_URL=http://localhost:5050

# Passwords used by "npm run seed" (it wipes the database and creates the
# admin + analyst users). Leave empty to get random passwords printed once.
# Min 8 characters, at least one letter and one number, no defaults like admin123.
SEED_ADMIN_PASSWORD=
SEED_ANALYST_PASSWORD=

# ---- PseudoLock: approvals + playbooks + response rules (all optional, see PSEUDOLOCK_SPECIFICATION_v1.0.md §11) ----
# How long a "Pending approval" waits before it expires (minutes, 1-1440)
APPROVAL_EXPIRY_MINUTES=30
# TriGate BLOCK on a PC with auto_response = false -> ask for approval (false = only Run buttons)
APPROVALS_FROM_TRIGATE=true
# Which TriGate verdicts create approvals: block  or  block,hold
APPROVAL_VERDICTS=block
# true = the person who asked for an approval cannot approve it themselves
APPROVAL_FOUR_EYES=false
# How long a playbook / approval waits for the agent's answer per action (seconds)
PLAYBOOK_ACTION_TIMEOUT_SECONDS=90
# Office hours for response rules "office hours only / outside office hours"
# (start hour - end hour on the PC's clock; 8-20 = 08:00 up to 19:59)
OFFICE_HOURS=8-20
